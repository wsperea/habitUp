# Copia este archivo como ".env" (sin .example) y ajusta los valores.
# El archivo .env NUNCA se sube a GitHub ni se comparte.

PORT=3000
NODE_ENV=development

# MongoDB instalado en tu computador:
MONGODB_URI=mongodb://127.0.0.1:27017/habitUp

# Cuando migres a Atlas, solo cambia la línea anterior por la de Atlas, por ejemplo:
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/habitUp?retryWrites=true&w=majority
